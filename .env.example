OPENAI_API_KEY=

# Optional model overrides
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-5.4-mini

# PostgreSQL — local docker-compose defaults
DATABASE_URL=postgresql+psycopg://helvetia:helvetia@localhost:5432/helvetia_bank
POSTGRES_USER=helvetia
POSTGRES_PASSWORD=helvetia
POSTGRES_DB=helvetia_bank
POSTGRES_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173

# pgAdmin (http://localhost:5050)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Deterministic synthetic seed
SEED_RNG_SEED=42

# Fill empty knowledge tables from data/policies/ on API startup (Neon-safe: skips if already loaded)
AUTO_INGEST=true
