OPENAI_API_KEY=your_openai_api_key_here

# Paths (relative to project root)
DOCUMENTS_DIR=data/documents
VECTOR_STORE_DIR=vector_store

# Models
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4.1-mini

AUTO_INGEST_ON_STARTUP=true

# PostgreSQL (v0.3+) — local docker-compose defaults
DATABASE_URL=postgresql+psycopg://helvetia:helvetia@localhost:5432/helvetia_bank
POSTGRES_USER=helvetia
POSTGRES_PASSWORD=helvetia
POSTGRES_DB=helvetia_bank
POSTGRES_PORT=5432

# pgAdmin (http://localhost:5050)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Deterministic synthetic seed
SEED_RNG_SEED=42