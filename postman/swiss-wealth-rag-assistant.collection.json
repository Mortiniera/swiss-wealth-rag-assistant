          },
          "response": []
        },
        {
          "name": "Get Client Service Requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clients/{{clientRef}}/service-requests",
              "host": ["{{baseUrl}}"],
              "path": ["clients", "{{clientRef}}", "service-requests"]
            },
            "description": "List client service requests."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
